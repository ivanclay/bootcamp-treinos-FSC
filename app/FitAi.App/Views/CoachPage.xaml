<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FitAi.App.ViewModels"
             xmlns:contracts="clr-namespace:FitAi.Contracts;assembly=FitAi.Contracts"
             x:Class="FitAi.App.Views.CoachPage"
             x:DataType="vm:CoachViewModel"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <!-- Cabeçalho -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="16,14">
            <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource BrandSoft}" StrokeThickness="0">
                <Image Source="tab_sparkles.png" WidthRequest="20" HeightRequest="20" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Coach AI" FontSize="15" FontAttributes="Bold" />
                <Label Text="● Online" FontSize="11" TextColor="#22C55E" />
            </VerticalStackLayout>
        </Grid>

        <!-- Mensagens -->
        <CollectionView Grid.Row="1" x:Name="MessagesView" ItemsSource="{Binding Messages}" Margin="16,0" ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatItem">
                    <Grid>
                        <Border IsVisible="{Binding IsUser}" HorizontalOptions="End" MaximumWidthRequest="300" BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16,4,16,16" Padding="14,10">
                            <Label Text="{Binding Content}" TextColor="White" FontSize="14" />
                        </Border>
                        <Border IsVisible="{Binding IsBot}" HorizontalOptions="Start" MaximumWidthRequest="300" BackgroundColor="{StaticResource Soft}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 4,16,16,16" Padding="14,10">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Html}" TextType="Html" FontSize="14" TextColor="{StaticResource Ink}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Videos}" IsVisible="{Binding HasVideos}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="contracts:ExerciseVideoResponse">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="150">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoachViewModel}}, Path=OpenVideoCommand, x:DataType=vm:CoachViewModel}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                                                    <Label Text="▶" FontSize="28" TextColor="White" BackgroundColor="#E6FF0000" Padding="14,2" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Label Text="{Binding Title}" TextColor="White" FontSize="11" BackgroundColor="#99000000" Padding="8,4" VerticalOptions="End" LineBreakMode="TailTruncation" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <VerticalStackLayout Padding="0,10" Spacing="10">
                    <Label Text="digitando…" IsVisible="{Binding IsSending}" TextColor="{StaticResource Muted}" FontSize="13" />
                    <Button Text="Ver meu plano de treino" IsVisible="{Binding PlanChanged}" Command="{Binding OpenPlanCommand}"
                            BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="20" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>

        <!-- Código do professor -->
        <Border Grid.Row="2" IsVisible="{Binding ShowInvite}" BackgroundColor="{StaticResource Soft}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Margin="16,4" Padding="12,8">
            <VerticalStackLayout Spacing="6">
                <Label Text="Tem um código do seu professor?" FontSize="12" TextColor="{StaticResource Muted}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Placeholder="FIT-XXXXXX" Text="{Binding InviteCode}" TextTransform="Uppercase" />
                    <Button Grid.Column="1" Text="Usar" Command="{Binding RedeemInviteCommand}" BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="18" HeightRequest="36" />
                </Grid>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource Danger}" FontSize="12" />
            </VerticalStackLayout>
        </Border>

        <!-- Sugestões -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Suggestions}" HeightRequest="44" Margin="16,4,0,4">
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Text="{Binding .}" FontSize="12" BackgroundColor="{StaticResource BrandSoft}" TextColor="#1E3A8A" CornerRadius="18" HeightRequest="36" Padding="12,0"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CoachViewModel}}, Path=SuggestionCommand, x:DataType=vm:CoachViewModel}"
                            CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <BoxView Grid.Row="4" HeightRequest="1" Color="{StaticResource Line}" />

        <!-- Composer -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="16,10,16,14">
            <Border BackgroundColor="{StaticResource Soft}" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="14,0">
                <Entry Placeholder="Digite sua mensagem" Text="{Binding Input}" ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
            </Border>
            <ImageButton Grid.Column="1" Source="icon_send.png" BackgroundColor="{StaticResource Primary}" CornerRadius="22" WidthRequest="44" HeightRequest="44" Padding="11"
                         Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</ContentPage>
