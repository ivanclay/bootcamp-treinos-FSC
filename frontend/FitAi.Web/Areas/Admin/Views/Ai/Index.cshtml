@model AiSettingsResponse
@{
    ViewData["Title"] = "Coach AI";
}
<div class="page-head">
    <div>
        <h1>Coach AI</h1>
        <p>Provedor, modelo, prompt e imagens de capa usados pelo chat. As chaves de API ficam só na configuração do servidor.</p>
    </div>
</div>
<form method="post" action="/admin/ia" asp-antiforgery="true">
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="panel mb-3">
                <h2>Provedor</h2>
                @foreach (var p in Model.AvailableProviders)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="Provider" id="p-@p.Name" value="@p.Name" checked="@(p.Name == Model.Provider)" disabled="@(!p.IsConfigured && p.Name != Model.Provider)" data-default-model="@p.DefaultModel" />
                        <label class="form-check-label" for="p-@p.Name">
                            <strong>@p.Name</strong> <span class="small text-secondary">(@p.Type · @p.DefaultModel)</span>
                            @if (!p.IsConfigured) { <span class="pill warn ms-1">Sem chave</span> }
                        </label>
                    </div>
                }
                <div class="form-text">Para habilitar um provedor, configure <code>Ai:Providers:&lt;Nome&gt;:ApiKey</code> na API.</div>
                <label class="form-label mt-3">Modelo</label>
                <input class="form-control" name="Model" value="@Model.Model" id="model" />
                <div class="form-text">Vazio usa o modelo padrão do provedor.</div>
            </div>
            <div class="panel">
                <h2>Imagens de capa</h2>
                <label class="form-label small">Treinos de superiores (uma URL por linha)</label>
                <textarea class="form-control mb-2" rows="3" name="UpperBodyCoverImages">@string.Join("\n", Model.UpperBodyCoverImages)</textarea>
                <label class="form-label small">Treinos de inferiores (uma URL por linha)</label>
                <textarea class="form-control" rows="3" name="LowerBodyCoverImages">@string.Join("\n", Model.LowerBodyCoverImages)</textarea>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="panel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="m-0">Prompt do sistema @(Model.IsCustomSystemPrompt ? Html.Raw("<span class=\"pill brand\">Personalizado</span>") : Html.Raw("<span class=\"pill\">Padrão</span>"))</h2>
                    @if (Model.IsCustomSystemPrompt)
                    {
                        <button class="btn btn-sm btn-outline-secondary" name="resetPrompt" value="true" type="submit">Voltar ao padrão</button>
                    }
                </div>
                <textarea class="form-control prompt" rows="26" name="SystemPrompt">@Model.SystemPrompt</textarea>
                <div class="form-text">As imagens de capa, o nome do professor e a restrição de criação de planos são adicionados automaticamente ao final.</div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end mt-3 mb-5"><button class="btn btn-primary" type="submit">Salvar configurações</button></div>
</form>
