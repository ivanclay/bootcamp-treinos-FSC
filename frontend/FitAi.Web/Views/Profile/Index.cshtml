@model ProfileViewModel
@{
    ViewData["Title"] = "Perfil";
    var user = Model.User;
    var data = Model.TrainData;
    var flash = TempData["Flash"] as string;
    var flashError = TempData["FlashError"] as string;
}
<div class="topbar"><div class="logo">FIT.AI</div></div>
<div class="page">
    @if (flash is not null) { <div class="alert success">@flash</div> }
    @if (flashError is not null) { <div class="alert error">@flashError</div> }

    <div class="profile-head">
        @if (user.Image is not null)
        {
            <div class="avatar" style="background-image:url('@user.Image')"></div>
        }
        else
        {
            <div class="avatar">@(user.Name.Length > 0 ? user.Name[..1].ToUpperInvariant() : "?")</div>
        }
        <div>
            <h1>@user.Name</h1>
            <p>@Format.Plan(Model.Plan.Plan)@(user.TeacherName is not null ? $" · Professor: {user.TeacherName}" : user.Role != UserRole.STUDENT ? $" · {Format.Role(user.Role)}" : "")</p>
        </div>
    </div>

    @if (data is null)
    {
        <div class="empty">
            Você ainda não informou seus dados.
            <a class="btn sm" href="/perfil/editar">Informar agora</a>
        </div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat"><span class="badge">@Icons.Get("weight", 16)</span><strong>@Format.Kg(data.WeightInGrams)</strong><span>KG</span></div>
            <div class="stat"><span class="badge">@Icons.Get("ruler", 16)</span><strong>@data.HeightInCentimeters</strong><span>CM</span></div>
            <div class="stat"><span class="badge">@Icons.Get("percent", 16)</span><strong>@data.BodyFatPercentage%</strong><span>GC</span></div>
            <div class="stat"><span class="badge">@Icons.Get("user", 16)</span><strong>@data.Age</strong><span>ANOS</span></div>
        </div>
        <a class="btn outline block" href="/perfil/editar">@Icons.Get("edit", 16) Editar dados</a>
    }

    @if (Model.Plan.Plan == PlanType.FREE && Model.Plan.Limits.CoachMessagesPerMonth is { } coachLimit)
    {
        var used = Math.Min(Model.Plan.CoachMessagesUsedThisMonth, coachLimit);
        <div class="card stack">
            <div class="row between"><strong>Plano Básico</strong><span class="small muted">este mês</span></div>
            <div class="small">Coach AI: <strong>@used</strong> de @coachLimit mensagens</div>
            <div style="height:6px;background:var(--bg-soft);border-radius:4px"><div style="height:6px;width:@(used * 100 / Math.Max(1, coachLimit))%;background:var(--brand);border-radius:4px"></div></div>
            @if (Model.Plan.Limits.AiPlansPerMonth is { } planLimit)
            {
                <div class="small">Planos montados pela IA: <strong>@Math.Min(Model.Plan.AiPlansCreatedThisMonth, planLimit)</strong> de @planLimit</div>
            }
            <span class="small muted">@(user.TeacherName is not null ? $"Quando {user.TeacherName} assinar o Pro, esses limites acabam." : "Com um professor no plano Pro, esses limites acabam.")</span>
        </div>
    }

    @foreach (var invite in Model.PendingInvites)
    {
        <div class="card stack">
            <strong>@invite.TeacherName quer ser seu professor</strong>
            <span class="small muted">Ao aceitar, @invite.TeacherName poderá ver seus dados (peso, altura, idade, % de gordura), seus planos e seus treinos, e montar planos para você.</span>
            <div class="row">
                <form method="post" action="/perfil/convites/@invite.Id/aceitar" asp-antiforgery="true"><button class="btn sm" type="submit">Aceitar</button></form>
                <form method="post" action="/perfil/convites/@invite.Id/recusar" asp-antiforgery="true"><button class="btn sm outline" type="submit">Recusar</button></form>
            </div>
        </div>
    }

    @if (user.Role == UserRole.STUDENT && user.TeacherId is null)
    {
        <form class="card stack" method="post" asp-antiforgery="true" action="/perfil/codigo">
            <strong>Tem um código do seu professor?</strong>
            <div class="row">
                <input class="input" name="code" placeholder="FIT-XXXXXX" required maxlength="20" style="text-transform:uppercase" />
                <button class="btn sm" type="submit">Usar</button>
            </div>
        </form>
    }

    @if (user.Role is UserRole.ADMIN or UserRole.TEACHER)
    {
        <a class="btn block" href="/admin">@Icons.Get("dashboard", 16) Área administrativa</a>
    }

    <form method="post" asp-antiforgery="true" action="/sair" class="center">
        <button class="btn ghost-danger" type="submit">Sair da conta @Icons.Get("log-out", 16)</button>
    </form>
</div>
